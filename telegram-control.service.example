[Unit]
Description=Strata Console Telegram Control Bot
After=hermes-strata-console.service
Requires=hermes-strata-console.service

[Service]
Type=simple
WorkingDirectory=%h/.hermes/strata-llm-console
EnvironmentFile=%h/.hermes/strata-llm-console/telegram-control.env
ExecStart=/usr/bin/python3 %h/.hermes/strata-llm-console/telegram_control_bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/.hermes/strata-console/data

[Install]
WantedBy=default.target
