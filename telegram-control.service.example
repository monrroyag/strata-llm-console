[Unit]
Description=Strata Console Telegram Control Bot
After=strata-llm-console.service
Requires=strata-llm-console.service

[Service]
Type=simple
WorkingDirectory=%h/.hermes/strata-llm-console
EnvironmentFile=%h/.hermes/strata-llm-console/telegram-control.env
ExecStart=/usr/bin/python3 %h/.hermes/strata-llm-console/telegram_control_bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=%h/.local/share/strata-llm-console/data %h/.local/share/strata-llm-console/logs

[Install]
WantedBy=default.target
